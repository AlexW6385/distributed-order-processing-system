POSTGRES_USER=orders
POSTGRES_PASSWORD=orders

# Payment simulation: decline charges above this amount, and make this share
# of charges (0..1) answer too slowly so the caller sees an unknown outcome.
PAYMENT_DECLINE_ABOVE_CENTS=100000
PAYMENT_FAULT_RATE=0

# How long a reserved order may wait for payment before it expires.
ORDER_PAYMENT_WINDOW=15m

RATE_LIMIT_PER_MINUTE=600
